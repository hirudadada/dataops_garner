DEV_APM_TLS=true

DEV_APM_HOST=https://${DEV_APM_SERVICE}:${DEV_APM_PORT}
DEV_APM_IMAGE=docker.elastic.co/beats/elastic-agent:${DEV_STACK_VERSION}

DEV_ELASTIC_APM_SERVICE_NAME=

DEV_ELASTIC_APM_SERVER_CA_CERT=/usr/local/share/ca-certificates/
DEV_ELASTIC_APM_SERVER_CA_CERT_FILE=${DEV_ELASTIC_APM_SERVER_CA_CERT}ca/ca.crt
DEV_ELASTIC_APM_ENABLED=true
DEV_ELASTIC_APM_SERVER_VERIFY_SERVER_CERT=true
DEV_ELASTIC_APM_POOL_SIZE=7
DEV_ELASTIC_APM_SECRET_TOKEN=
DEV_ELASTIC_APM_SECRET_TOKEN_ENCRYPTED=

# # Heap size
# APM_JAVA_OPTS="-Xms256m -Xmx256m"
