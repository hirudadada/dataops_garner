STACK_VERSION=8.12.2

DEV_CLUSTER_NAME=elastic-system
ENCRYPTION_KEY=thirty-two-or-more-random-characters

# APM standalone
APM_JAVA_OPTS="-Xms256m -Xmx256m"

# Fleet Setup
DEV_ES_SERVICE=ecp-elasticsearch
DEV_ES_PORT=9200
DEV_KBN_SERVICE=ecp-kibana
DEV_KBN_PORT=5601
DEV_FLEET_SERVICE=ecp-fleet-server
DEV_FLEET_PORT=8220
DEV_AGENT_SERVICE=ecp-elastic-agent
DEV_AGENT_PORT=8200
# Setup image
DEV_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:${STACK_VERSION}
# Agent image
DEV_AGENT_IMAGE=docker.elastic.co/beats/elastic-agent:${STACK_VERSION}

# Elastic Search heap size
ES_JAVA_OPTS="-Xms1g -Xmx1g"
# Kibana heap size
NODE_OPTIONS="--max_old_space_size=2048"
DEV_ES_HTTPS_HOST=https://${DEV_ES_SERVICE}:${DEV_ES_PORT}
DEV_KBN_HTTPS_HOST=https://${DEV_KBN_SERVICE}:${DEV_KBN_PORT}
DEV_FLEET_HTTPS_HOST=https://${DEV_FLEET_SERVICE}:${DEV_FLEET_PORT}
DEV_AGENT_HTTPS_HOST=https://${DEV_AGENT_SERVICE}:${DEV_AGENT_PORT}

# # License
# LICENSE=basic
LICENSE=trial

# Passwords
ELASTIC_PASSWORD=15nX7Nu2AOzekqB953n5tw42
KIBANA_USERNAME=kibana_system
KIBANA_PASSWORD=15nX7Nu2AOzekqB953n5tw42

# Agent enrollment token
FLEET_ENROLLMENT_TOKEN=WW5DR0xJNEJaVXItSmxVWnVsc286LWVaZWRTY3lTcjJYOWRsTDlQTkxFdw==

# # Fleet server
# FLEET_SERVER_SERVICE_TOKEN=
# FLEET_SERVER_POLICY_ID=fleet-server-policy

CERTS_DIR=config/certs
INSTANCES_FILE=config/certs/instances.yml
AGENT_CERTS_ZIP=config/certs/elastic-agent-certs.zip
AGENT_NAME=elastic-agent
AGENT_CERTS_DIR="${CERTS_DIR}/elastic-agent"
